# ─── Tradebot .env — copy to .env and fill in your values ────────────────────

# Birdeye API key (get one at https://birdeye.so/data-api)
BIRDEYE_API_KEY=your_birdeye_api_key_here

# Helius API key — free tier covers wallet polling + websockets
# Sign up at https://helius.dev
HELIUS_API_KEY=8ae9737f-b487-485f-b4c9-fadf63a3c0d6

# Your Solana wallet private key (Base58 format)
# ⚠️  NEVER share this. Store securely. Use a dedicated bot wallet.
# Fund it with only what you're willing to risk.
SOLANA_PRIVATE_KEY=your_base58_private_key_here

# Set to False ONLY when you are ready to trade real money
PAPER_TRADING=True

# SQLite DB file path (default is fine)
DB_PATH=tradebot.db

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
